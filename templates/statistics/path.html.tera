{% extends "base" %}

{% block content %}
<article>
  <header class="d-flex align-items-center justify-content-between">
    <div>
      <h1 class="h5 mb-1">Statistics {% if path == "__all__" %}for ALL{% else %}for "{{ path }}"{% endif %}</h1>
      <p class="text-body-secondary small mb-0">Daily visits and recent activity</p>
    </div>
    
  </header>

  <section class="mt-3">
    <h2 class="h6">Daily visits</h2>
    <div class="card">
      <div class="card-body">
        <canvas id="visitsChart" height="120"></canvas>
      </div>
    </div>
  </section>

  <section class="mt-3">
    <div class="d-flex align-items-center justify-content-between">
      <h2 class="h6 mb-0">Visits</h2>
      <nav aria-label="Pagination">
        <ul class="pagination pagination-sm mb-0">
          {% if has_prev %}
          <li class="page-item">
            {% if path == "__all__" %}
            <a class="page-link" href="/statistics/__all__?page={{ prev_page }}">Prev</a>
            {% else %}
            <a class="page-link" href="/statistics/{{ path }}?page={{ prev_page }}">Prev</a>
            {% endif %}
          </li>
          {% else %}
          <li class="page-item disabled"><span class="page-link">Prev</span></li>
          {% endif %}

          <li class="page-item disabled">
            <span class="page-link">Page {{ current_page }} / {{ total_pages }}</span>
          </li>

          {% if has_next %}
          <li class="page-item">
            {% if path == "__all__" %}
            <a class="page-link" href="/statistics/__all__?page={{ next_page }}">Next</a>
            {% else %}
            <a class="page-link" href="/statistics/{{ path }}?page={{ next_page }}">Next</a>
            {% endif %}
          </li>
          {% else %}
          <li class="page-item disabled"><span class="page-link">Next</span></li>
          {% endif %}
        </ul>
      </nav>
    </div>

    <div class="table-responsive mt-2">
      <table class="table table-sm table-striped table-hover align-middle mb-0" role="grid">
        <thead class="table-light">
          <tr>
            <th style="white-space:nowrap;">Timestamp</th>
            <th>Path</th>
            <th>IP</th>
            <th style="min-width: 260px;">Headers JSON</th>
          </tr>
        </thead>
        <tbody>
          {% for v in last %}
          <tr>
            <td style="white-space:nowrap;">{{ v.timestamp }}</td>
            <td class="text-break">{{ v.path }}</td>
            <td class="text-break">{{ v.ip }}</td>
            <td>
              <details>
                <summary class="text-body-secondary">Show</summary>
                <pre class="json pretty mb-0">{{ v.json }}</pre>
              </details>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="d-flex align-items-center justify-content-end mt-2">
      <nav aria-label="Pagination bottom">
        <ul class="pagination pagination-sm mb-0">
          {% if has_prev %}
          <li class="page-item">
            {% if path == "__all__" %}
            <a class="page-link" href="/statistics/__all__?page={{ prev_page }}">Prev</a>
            {% else %}
            <a class="page-link" href="/statistics/{{ path }}?page={{ prev_page }}">Prev</a>
            {% endif %}
          </li>
          {% else %}
          <li class="page-item disabled"><span class="page-link">Prev</span></li>
          {% endif %}

          <li class="page-item disabled">
            <span class="page-link">Page {{ current_page }} / {{ total_pages }}</span>
          </li>

          {% if has_next %}
          <li class="page-item">
            {% if path == "__all__" %}
            <a class="page-link" href="/statistics/__all__?page={{ next_page }}">Next</a>
            {% else %}
            <a class="page-link" href="/statistics/{{ path }}?page={{ next_page }}">Next</a>
            {% endif %}
          </li>
          {% else %}
          <li class="page-item disabled"><span class="page-link">Next</span></li>
          {% endif %}
        </ul>
      </nav>
    </div>
  </section>
</article>

<script>
const labels = {{ labels | json_encode | safe }};
const counts = {{ counts | json_encode | safe }};

const ctx = document.getElementById('visitsChart').getContext('2d');
new Chart(ctx, {
  type: 'line',
  data: {
    labels,
    datasets: [{
      label: 'Daily visits',
      data: counts,
      borderColor: 'rgb(79, 70, 229)',
      backgroundColor: 'rgba(79, 70, 229, 0.15)',
      tension: 0.25,
      fill: true,
      pointRadius: 2
    }]
  },
  options: {
    responsive: true,
    maintainAspectRatio: true,
    plugins: { legend: { display: false }, tooltip: { intersect: false, mode: 'index' } },
    scales: { x: { grid: { display: false } }, y: { beginAtZero: true, ticks: { precision: 0 } } }
  }
});

// Pretty-print inline JSON blocks for readability
document.querySelectorAll('pre.json.pretty').forEach(el => {
  try {
    const text = el.textContent.trim();
    const obj = JSON.parse(text);
    el.textContent = JSON.stringify(obj, null, 2);
  } catch (e) {
    // leave as-is if not valid JSON
  }
});
</script>
{% endblock content %}