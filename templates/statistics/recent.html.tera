{% extends "base" %}

{% block content %}
<article>
  <header class="d-flex align-items-center justify-content-between">
    <h1 class="h4 mb-0">Recent visits</h1>
    <span class="text-body-secondary small">Last 20 events</span>
  </header>

  <section class="mt-3">
    <div class="table-responsive">
      <table class="table table-sm table-striped table-hover align-middle mb-0" role="grid">
        <thead class="table-light">
          <tr>
            <th style="white-space:nowrap;">Timestamp</th>
            <th>Path</th>
            <th>IP</th>
            <th style="min-width: 260px;">Headers JSON</th>
          </tr>
        </thead>
        <tbody>
          {% for v in items %}
          <tr>
            <td style="white-space:nowrap;">{{ v.timestamp }}</td>
            <td class="text-break"><a class="text-decoration-none link-body-emphasis" href="/statistics/{{ v.path }}">{{ v.path }}</a></td>
            <td class="text-break">{{ v.ip }}</td>
            <td>
              <details>
                <summary class="text-body-secondary">Show</summary>
                <pre class="json pretty mb-0">{{ v.json }}</pre>
              </details>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
</article>

<script>
// Pretty-print inline JSON blocks for readability
document.querySelectorAll('pre.json.pretty').forEach(el => {
  try {
    const text = el.textContent.trim();
    const obj = JSON.parse(text);
    el.textContent = JSON.stringify(obj, null, 2);
  } catch (e) {
    // leave as-is if not valid JSON
  }
});
</script>
{% endblock content %}