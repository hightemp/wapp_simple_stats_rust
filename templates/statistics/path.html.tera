{% extends "base" %}

{% block content %}
<nav class="breadcrumbs" aria-label="Хлебные крошки">
  <a href="/statistics">Статистика</a>
  <span aria-hidden="true">/</span>
  <span aria-current="page">{% if all_paths %}Все посещения{% else %}{{ path }}{% endif %}</span>
</nav>

<header class="page-heading path-heading">
  <div>
    <span class="eyebrow">{% if all_paths %}Общая аналитика{% else %}Отдельная страница{% endif %}</span>
    <h1>{% if all_paths %}Все посещения{% else %}<span class="heading-prefix">Путь</span> {{ path }}{% endif %}</h1>
    <p>Динамика за последние 30 календарных дней и подробная история событий.</p>
  </div>
  <a class="button button-secondary" href="/statistics/recent">Последние события</a>
</header>

<section class="metric-grid" aria-label="Ключевые показатели">
  <article class="metric-card metric-accent">
    <span class="metric-label">Всего посещений</span>
    <strong>{{ total }}</strong>
    <span class="metric-note">за всё время</span>
  </article>
  <article class="metric-card">
    <span class="metric-label">Сегодня</span>
    <strong>{{ today }}</strong>
    <span class="metric-note">с начала дня</span>
  </article>
  <article class="metric-card">
    <span class="metric-label">Последние 7 дней</span>
    <strong>{{ week }}</strong>
    <span class="metric-note">включая сегодня</span>
  </article>
  <article class="metric-card">
    <span class="metric-label">Среднее за 30 дней</span>
    <strong>{{ average_daily }}</strong>
    <span class="metric-note">посещения в день</span>
  </article>
</section>

<section class="panel chart-panel">
  <header class="panel-header">
    <div>
      <h2>Динамика посещений</h2>
      <p>30 календарных дней, включая дни без событий</p>
    </div>
    <div class="chart-summary"><strong>{{ max_daily }}</strong><span>максимум за день</span></div>
  </header>

  <div class="chart-wrap">
    <svg class="line-chart" viewBox="0 0 720 220" role="img" aria-labelledby="chart-title chart-description" preserveAspectRatio="none">
      <title id="chart-title">Посещения за 30 дней</title>
      <desc id="chart-description">Максимальное количество посещений за день: {{ max_daily }}</desc>
      <defs><linearGradient id="area-gradient" x1="0" y1="0" x2="0" y2="1"><stop offset="0"/><stop offset="1"/></linearGradient></defs>
      <g class="chart-grid" aria-hidden="true"><line x1="16" y1="32" x2="704" y2="32"/><line x1="16" y1="87" x2="704" y2="87"/><line x1="16" y1="142" x2="704" y2="142"/><line x1="16" y1="196" x2="704" y2="196"/></g>
      <polygon class="chart-area" points="16,196 {{ chart_points }} 704,196" aria-hidden="true"/>
      <polyline class="chart-line" points="{{ chart_points }}" aria-hidden="true"/>
      {% for day in daily %}<circle class="chart-point" cx="{{ day.x }}" cy="{{ day.y }}" r="3"><title>{{ day.date }}: {{ day.count }}</title></circle>{% endfor %}
    </svg>
    <div class="chart-axis"><span>{{ daily.0.date }}</span><span>Сегодня</span></div>
  </div>

  <details class="daily-details">
    <summary>Показать данные по дням</summary>
    <div class="daily-grid">
      {% for day in daily %}<div><time datetime="{{ day.date }}">{{ day.date }}</time><strong>{{ day.count }}</strong></div>{% endfor %}
    </div>
  </details>
</section>

<section class="panel visits-panel">
  <header class="panel-header panel-header-toolbar">
    <div>
      <h2>История посещений</h2>
      <p>{{ unique_ips }} уникальных адресов · записи {{ range_start }}–{{ range_end }} из {{ total }}</p>
    </div>
    {% if visits | length > 0 %}
    <label class="search-box">
      <span class="sr-only">Фильтр текущей страницы</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 4 4"/></svg>
      <input type="search" placeholder="Путь, IP, браузер" autocomplete="off" data-visit-filter>
    </label>
    {% endif %}
  </header>

  {% include "statistics/_visit_list" %}
  {% include "statistics/_pagination" %}
</section>
{% endblock content %}
