{% extends "base" %}

{% block content %}
<article>
  <header class="d-flex align-items-center justify-content-between">
    <h1 class="h4 mb-0">Statistics</h1>
    <span class="badge text-bg-primary">Total: {{ total }}</span>
  </header>

  <section class="mt-3">
    <div class="table-responsive">
      <table class="table table-sm table-striped table-hover align-middle mb-0" role="grid">
        <thead class="table-light">
          <tr>
            <th>Path</th>
            <th class="text-end" style="width: 1%;">Visitors</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><a href="/statistics/__all__" class="link-primary text-decoration-none">ALL</a></td>
            <td class="text-end">{{ total }}</td>
          </tr>
          {% for e in entries %}
          <tr>
            <td class="text-break"><a href="/statistics/{{ e.path }}" class="link-body-emphasis text-decoration-none">{{ e.path }}</a></td>
            <td class="text-end">{{ e.count }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
</article>
{% endblock content %}