<!doctype html>
<html lang="en" data-bs-theme="auto">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{ page_title | default(value="Simple Stats") }} — {{ site_title | default(value="Simple Stats") }}</title>
  <link rel="icon" href='data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128"><text y="1em" font-size="96">📈</text></svg>'>
  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <style>
    :root { --accent: #4f46e5; }
    body { font-size: 0.95rem; }
    header.site-header { margin: .75rem 0 1.25rem; }
    .brand { font-weight: 700; font-size: 1rem; }
    .nav-link { padding: .25rem .5rem; }
    h1, h2, h3 { margin-top: .75rem; margin-bottom: .75rem; }
    table { font-size: .92rem; }
    pre { white-space: pre-wrap; word-break: break-word; }
    .badge-accent { background: var(--accent); }
    .content { padding-bottom: 2rem; }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>
<body>
  <div class="container-xl content">
    <header class="site-header d-flex align-items-center justify-content-between">
      <div class="brand">{{ site_title | default(value="Simple Stats") }}</div>
      <ul class="nav">
        <li class="nav-item"><a class="nav-link link-secondary" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link link-primary" href="/statistics">Statistics</a></li>
      </ul>
    </header>

    {% block content %}{% endblock content %}

    <footer class="mt-4 text-body-secondary small">
      Powered by wapp_simple_stats_rust
    </footer>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>