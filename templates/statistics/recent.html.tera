{% extends "base" %}

{% block content %}
<header class="page-heading">
  <div>
    <span class="eyebrow">Живая лента</span>
    <h1>Последние посещения</h1>
    <p>Свежие события со всех отслеживаемых страниц.</p>
  </div>
  <a class="button button-secondary" href="/statistics/__all__">Аналитика за 30 дней</a>
</header>

<section class="metric-strip" aria-label="Краткая статистика">
  <div><span>Сегодня</span><strong>{{ today }}</strong></div>
  <div><span>За 7 дней</span><strong>{{ week }}</strong></div>
  <div><span>Страниц</span><strong>{{ unique_paths }}</strong></div>
  <div><span>Всего</span><strong>{{ total }}</strong></div>
</section>

<section class="panel visits-panel">
  <header class="panel-header panel-header-toolbar">
    <div>
      <h2>События</h2>
      <p>Показаны записи {{ range_start }}–{{ range_end }} из {{ total }}</p>
    </div>
    {% if visits | length > 0 %}
    <label class="search-box">
      <span class="sr-only">Фильтр текущей страницы</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 4 4"/></svg>
      <input type="search" placeholder="Путь, IP, браузер" autocomplete="off" data-visit-filter>
    </label>
    {% endif %}
  </header>

  {% include "statistics/_visit_list" %}
  {% include "statistics/_pagination" %}
</section>
{% endblock content %}
