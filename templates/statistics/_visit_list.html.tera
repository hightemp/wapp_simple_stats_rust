{% if visits | length > 0 %}
<div class="visit-list" id="visit-list">
  {% for visit in visits %}
  <article class="visit-card" data-visit-row data-search-value="{{ visit.path }} {{ visit.ip }} {{ visit.user_agent }} {{ visit.referer }}">
    <header class="visit-header">
      <div class="visit-time">
        <span class="status-dot" aria-hidden="true"></span>
        <time datetime="{{ visit.timestamp }}">{{ visit.timestamp }}</time>
      </div>
      <a class="path-pill" href="/statistics/{{ visit.path_url }}">{{ visit.path }}</a>
    </header>
    <div class="visit-details">
      <div class="visit-field visit-ip">
        <span class="field-label">IP address</span>
        <div><code>{{ visit.ip }}</code><button class="mini-copy" type="button" data-copy="{{ visit.ip }}" aria-label="Copy IP address" title="Copy IP address">⧉</button></div>
      </div>
      <div class="visit-field visit-agent">
        <span class="field-label">Device and browser</span>
        <span title="{{ visit.user_agent }}">{{ visit.user_agent }}</span>
      </div>
      <div class="visit-field visit-source">
        <span class="field-label">Source</span>
        <span title="{{ visit.referer }}">{{ visit.referer }}</span>
      </div>
      <div class="visit-field visit-language">
        <span class="field-label">Language</span>
        <span title="{{ visit.language }}">{{ visit.language }}</span>
      </div>
    </div>
    <details class="metadata-details">
      <summary>Technical metadata</summary>
      <pre>{{ visit.headers_pretty }}</pre>
    </details>
  </article>
  {% endfor %}
</div>
<div class="empty-state compact" data-visit-empty hidden>No matches on this page.</div>
{% else %}
<div class="empty-state">
  <div class="empty-icon" aria-hidden="true">⌁</div>
  <h3>No visits yet</h3>
  <p>New events will appear here as soon as the counter receives a request.</p>
</div>
{% endif %}
