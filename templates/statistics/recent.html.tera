{% extends "base" %}

{% block content %}
<header class="page-heading">
  <div>
    <span class="eyebrow">Live feed</span>
    <h1>Recent visits</h1>
    <p>Latest events across all tracked pages.</p>
  </div>
  <a class="button button-secondary" href="/statistics/__all__">30-day analytics</a>
</header>

<section class="metric-strip" aria-label="Summary statistics">
  <div><span>Today</span><strong>{{ today }}</strong></div>
  <div><span>Last 7 days</span><strong>{{ week }}</strong></div>
  <div><span>Pages</span><strong>{{ unique_paths }}</strong></div>
  <div><span>Total</span><strong>{{ total }}</strong></div>
</section>

<section class="panel visits-panel">
  <header class="panel-header panel-header-toolbar">
    <div>
      <h2>Events</h2>
      <p>Showing records {{ range_start }}–{{ range_end }} of {{ total }}</p>
    </div>
    {% if visits | length > 0 %}
    <label class="search-box">
      <span class="sr-only">Filter this page</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 4 4"/></svg>
      <input type="search" placeholder="Path, IP, or browser" autocomplete="off" data-visit-filter>
    </label>
    {% endif %}
  </header>

  {% include "statistics/_visit_list" %}
  {% include "statistics/_pagination" %}
</section>
{% endblock content %}
