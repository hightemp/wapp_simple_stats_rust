<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{ page_title | default(value="Simple Stats") }} — {{ site_title | default(value="Simple Stats") }}</title>
  <link rel="icon" href='data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128"><text y="1em" font-size="96">📈</text></svg>'>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.min.css">
  <style>
  :root { --accent: #4f46e5; }
  header.site-header { display:flex; align-items:center; justify-content:space-between; margin: 1rem 0 2rem; }
  header .title { font-weight: 700; }
  .stat-table table { width: 100%; }
  .stat-table td pre { white-space: pre-wrap; word-break: break-all; }
  .badge { display:inline-block; padding:.25rem .5rem; border-radius:.5rem; background: var(--accent); color:#fff; font-size:.8rem; }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>
<body>
<main class="container">
  <header class="site-header">
    <div class="title">{{ site_title | default(value="Simple Stats") }}</div>
    <nav>
      <ul>
        <li><a href="/statistics">Statistics</a></li>
      </ul>
    </nav>
  </header>

  {% block content %}{% endblock content %}

  <footer style="margin-top:3rem; opacity: .7;">
    <small>Powered by wapp_simple_stats_rust</small>
  </footer>
</main>
</body>
</html>